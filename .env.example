# Copy to .env (gitignored). Read by src/config.py from the repo root.

# Claude writes the decision explanations (`just explain`). Use an API key from the
# Anthropic console (sk-ant-api...). Prod (Streamlit Cloud) needs no key: it serves the
# committed data/explanations/cache.json. Set one there (Secrets panel) only for live
# explanations of changed scenario numbers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Model assumptions (contest ratio, female share, fallback price) live in
# data/scenarios/baseline.yaml, not here.

# Google Places API (branch ratings/reviews), restricted to places.googleapis.com
GOOGLE_MAPS_API_KEY=

# Mapbox Isochrone API (scripts/fetch_isochrones.py); free token at account.mapbox.com
MAPBOX_ACCESS_TOKEN=
